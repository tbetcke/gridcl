# Remote-test targets of scripts/hpc/remote-test.sh.
#
# Copy this file to scripts/hpc/targets.env (git-ignored) and fill in the values there.
# Never put values in this file: user ids, host names and project codes stay personal.
# The file is sourced by bash; quote values that contain spaces.
#
# Keys per target, with the prefix MYRIAD_V100_, MYRIAD_A100_, MYRIAD_CPU_, LOCUST_ or KATHLEEN_:
#   HOST            SSH host alias from ~/.ssh/config (required)
#   SCHEDULER       sge, slurm or direct (required)
#   BASE            remote base directory (absolute, no spaces; required); one tree per
#                   branch is kept below it, <BASE>/<branch with '/' replaced by '_'>
#   LOGIN_MODULES   shell commands run on the login node before the fetch step
#   MODULES         shell commands run in the job before the command (module lines)
#   CUDA_PATH       CUDA toolkit root, exported as CUDA_PATH in the job after MODULES
#   CORES_REQUEST   scheduler options for --cores N, with {cores} for N; also used with N
#                   ranks for --ranks N without --cores (sge only; one #$ line)
#   MEM_REQUEST     scheduler options added to every job, such as the memory request
#                   (sge only; one #$ line)
#
# Myriad (RHEL 7.9, glibc 2.17; docs/dev-environment.md, ADR-0004): LOGIN_MODULES and MODULES
# load GCC 10 (module purge first), export CC, CXX and the cargo linker as gcc, and use the
# Spack-built LLVM of scripts/hpc/spack/setup.sh:
#   export XDG_DATA_HOME=<llvm root>/xdg PATH=<llvm root>/lld-bin:$PATH
# MODULES also loads the CUDA 12.x module (cudarc reads the CUDA version from nvcc at build time).
# For the mpi feature, both load Open MPI 4.0.5 built with GCC 10 and its prerequisites
# (numactl, binutils and ucx modules), and export LIBCLANG_PATH and CLANG_PATH from the llvm/8.0.0
# install for rsmpi's bindgen, without loading that module (its bin/ and LIBRARY_PATH would
# come before the Spack-built LLVM).
#
# Myriad CPU (CPU-only D nodes, ADR-0014): the same HOST, BASE (one shared tree), CORES_REQUEST
# and MEM_REQUEST as the V100. LOGIN_MODULES and MODULES are the V100's login-node lines (no
# CUDA module); CUDA_PATH stays empty. The file is sourced by bash, so they may refer to the
# V100 keys, e.g. MYRIAD_CPU_MODULES=$MYRIAD_V100_LOGIN_MODULES.
#
# Locust (RHEL 9.3, aarch64; docs/dev-environment.md): SCHEDULER=direct, BASE on the node's data
# disk (not the shared home). LOGIN_MODULES and MODULES are the same lines: they point HOME,
# the XDG directories, TMPDIR, CUDA_CACHE_PATH, CARGO_HOME and RUSTUP_HOME at the data disk,
# unset RUSTUP_TOOLCHAIN (rust-toolchain.toml decides), put cargo and a Spack view with CUDA 12.x
# and Open MPI 5 on PATH and LD_LIBRARY_PATH, export CUDARC_CUDA_VERSION, LIBCLANG_PATH=/usr/lib64
# (system clang) and CARGO_BUILD_JOBS (a shared node), and link with rust-lld:
#   CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=lld
#     -Clink-arg=-B$RUSTUP_HOME/toolchains/<toolchain>/lib/rustlib/aarch64-unknown-linux-gnu/bin/gcc-ld"
# (GNU ld 2.35 misses CubeCL's LLVM symbols, as on Myriad), and export RUSTDOCFLAGS with the same
# flags, since rustdoc ignores that RUSTFLAGS variable and doctests would link with GNU ld.
# CUDA_PATH is the Spack view.
#
# Kathleen (Slurm, RHEL 9.6, x86-64, no GPU; ADR-0016, docs/dev-environment.md): SCHEDULER=slurm,
# BASE below a gridcl root on Scratch (Lustre; home and Scratch share one 250 GiB quota), e.g.
# <scratch>/gridcl/src. LOGIN_MODULES and MODULES are the same lines: `module purge` and the pinned
# modules of the ucl-stack (gcc 12.3.0, Open MPI 4.1.6, the hidden llvm 17.0.6 module for
# rsmpi's bindgen), HOME, the XDG directories, CARGO_HOME and RUSTUP_HOME below the gridcl root,
# unset RUSTUP_TOOLCHAIN (rust-toolchain.toml decides), cargo on PATH, LIBCLANG_PATH from
# `llvm-config --libdir`, CC and CXX back to the gcc module's gcc and g++ (the llvm module sets
# its clang), and the gcc module's runtime first on LD_LIBRARY_PATH (CubeCL's CPU runtime needs
# its libstdc++). CUDA_PATH, CORES_REQUEST and MEM_REQUEST stay empty: jobs take whole nodes
# (--nodes) and jobs/kathleen.sh holds the Slurm lines. The prebuilt LLVM bundle works on RHEL 9.
# For M7's partitioners (built once by `remote-test.sh kathleen -- scripts/hpc/build-partition-libs.sh`
# into <BASE>/partition-libs), the same lines end with the exports that script prints:
#   export GRIDCL_PARTITION_LIBS=<BASE>/partition-libs
#   export SCOTCH_DIR=$GRIDCL_PARTITION_LIBS/scotch-<version>
#     PARMETIS_DIR=$GRIDCL_PARTITION_LIBS/parmetis-<version>
#     METIS_DIR=$GRIDCL_PARTITION_LIBS/parmetis-<version>   (ParMETIS's own METIS)
#   CPATH (Scotch's include/, for the scotch feature), LIBRARY_PATH and LD_LIBRARY_PATH
#   (Scotch's and ParMETIS's lib/) prepended.

MYRIAD_V100_HOST=
MYRIAD_V100_SCHEDULER=
MYRIAD_V100_BASE=
MYRIAD_V100_LOGIN_MODULES=
MYRIAD_V100_MODULES=
MYRIAD_V100_CUDA_PATH=
MYRIAD_V100_CORES_REQUEST=
MYRIAD_V100_MEM_REQUEST=

MYRIAD_A100_HOST=
MYRIAD_A100_SCHEDULER=
MYRIAD_A100_BASE=
MYRIAD_A100_LOGIN_MODULES=
MYRIAD_A100_MODULES=
MYRIAD_A100_CUDA_PATH=
MYRIAD_A100_CORES_REQUEST=
MYRIAD_A100_MEM_REQUEST=

MYRIAD_CPU_HOST=
MYRIAD_CPU_SCHEDULER=
MYRIAD_CPU_BASE=
MYRIAD_CPU_LOGIN_MODULES=
MYRIAD_CPU_MODULES=
MYRIAD_CPU_CUDA_PATH=
MYRIAD_CPU_CORES_REQUEST=
MYRIAD_CPU_MEM_REQUEST=

LOCUST_HOST=
LOCUST_SCHEDULER=
LOCUST_BASE=
LOCUST_LOGIN_MODULES=
LOCUST_MODULES=
LOCUST_CUDA_PATH=
LOCUST_CORES_REQUEST=
LOCUST_MEM_REQUEST=

KATHLEEN_HOST=
KATHLEEN_SCHEDULER=
KATHLEEN_BASE=
KATHLEEN_LOGIN_MODULES=
KATHLEEN_MODULES=
KATHLEEN_CUDA_PATH=
KATHLEEN_CORES_REQUEST=
KATHLEEN_MEM_REQUEST=

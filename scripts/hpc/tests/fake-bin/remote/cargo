#!/usr/bin/env bash
# Fake cargo of the remote nodes (scripts/hpc/tests): logs its arguments with
# CARGO_NET_OFFLINE and CARGO_TARGET_DIR to $FAKE_STATE/cargo.log and succeeds.
set -u
printf 'offline=%s target_dir=%s args=%s\n' "${CARGO_NET_OFFLINE:-}" "${CARGO_TARGET_DIR:-}" \
    "$*" >>"${FAKE_STATE:?}/cargo.log"
case ${1:-} in
    --version) echo "cargo 1.99.1 (fake)" ;;
esac
exit 0
